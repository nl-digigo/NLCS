PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

# Bewerking = het deel van de objectnaam ná het '-' (bijv. GROND_GROND-WERK -> WERK,
# DWA_RIOOLPUT-OPHOOGTEBRENGEN -> OPHOOGTEBRENGEN). De oude bewerking-aspect-property
# (nlcs:9e8d26b2-…) bestaat niet meer in de data; de bewerkte objecten dragen de
# bewerking in hun eigen naam (zelfde aanpak als controle_object_bewerking).

SELECT DISTINCT ?hoofdgroep ?bewerking
WHERE {
  ?topConcept a owl:Class ;
              skos:prefLabel "NLCS-object" .

  ?hoofdgroepURI rdfs:subClassOf ?topConcept ;
                 skos:prefLabel ?hoofdgroep .

  ?objectURI rdfs:subClassOf+ ?hoofdgroepURI ;
             skos:prefLabel ?omschrijving .

  FILTER(CONTAINS(?omschrijving, "-"))
  BIND(STRAFTER(?omschrijving, "-") AS ?bewerking)
}
ORDER BY ?hoofdgroep ?bewerking
