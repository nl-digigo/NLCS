PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX nen2660: <https://w3id.org/nen2660/def#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX otl:     <http://www.laces.tech/publication/ns/semmtech/live/laces/schema/otl-manager/>
PREFIX bp:      <http://www.laces.tech/publication/ns/semmtech/live/laces/schema/blueprint-manager/>
PREFIX shapes:  <http://www.laces.tech/publication/ns/semmtech/live/laces/schema/shapes/>

# ─────────────────────────────────────────────────────────────────────────────
# construct_aspects_for_workspace_import.rq
#
# Generates a lightweight TTL for re-importing Status and Discipline aspects
# into each hoofdgroep workspace.  For each aspect it emits:
#
#   Block A  — otl:Aspect with name, sequence node, datatype + registrational
#              flags, and otl:rel-Aspect-isRelatedTo the local qualification group
#   Block B  — otl:GroupForQualifications with name, sequence node, and an
#              External-link back to its own original 5.0 URI (same mechanism
#              as Block D). Every hoofdgroep workspace imports its own local
#              copy of Statussen/Disciplines, so without this the group's
#              identity can't be resolved back to a single canonical URI when
#              hoofdgroep publications are merged together - it would surface
#              as N duplicate "Statussen" groups instead of one.
#   Block C  — otl:Qualification members with name, sequence node, and their
#              5.0 original URI stored verbatim as otl:attr-Conceptual-description.
#              Laces re-mints a local URI for each Qualification on import into
#              every hoofdgroep workspace; the stylesheet (laces-to-NLCS-concept_split.ttl,
#              ex:ConvertAspectWithRole) reads this back so that an object's
#              filled Status/Discipline value is published against the
#              qualification's correct original URI instead of the local one.
#   Block D  — External-link relation node per aspect, pointing from the aspect
#              to the canonical GroupForQualifications URI in the shared workspace
#              (same URI used by construct_shared_as_laces_otl.rq)
#
# Usage (Apache Jena ARQ):
#   arq --data NLCS_5_0_2_2026-05-22_0944.ttl \
#       --query construct_aspects_for_workspace_import.rq \
#       --out aspects.ttl
# ─────────────────────────────────────────────────────────────────────────────

CONSTRUCT {

  # ── Block A: otl:Aspect ──────────────────────────────────────────────────
  ?aspectProp a otl:Aspect .
  ?aspectProp shapes:sequence ?aspectSeqNode .
  ?aspectSeqNode rdf:type otl:Seq_attr-Conceptual-name .
  ?aspectSeqNode rdf:_1 ?aspectLabel .
  ?aspectSeqNode owl:annotatedProperty otl:attr-Conceptual-name .
  ?aspectProp otl:attr-Conceptual-name ?aspectLabel .
  ?aspectProp otl:attr-Aspect-datatype "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
  ?aspectProp otl:attr-Aspect-registrational "false"^^xsd:boolean .
  ?aspectProp otl:rel-Aspect-isRelatedTo ?enumGroup .

  # ── Block B: GroupForQualifications ─────────────────────────────────────
  ?enumGroup a otl:GroupForQualifications .
  ?enumGroup otl:attr-Group-name ?groupName .
  ?enumGroup shapes:sequence ?groupSeqNode .
  ?groupSeqNode rdf:type otl:Seq_attr-Group-name .
  ?groupSeqNode rdf:_1 ?groupName .
  ?groupSeqNode owl:annotatedProperty otl:attr-Group-name .
  ?enumGroup otl:rel-Conceptual-hasExternalLink ?groupExtLinkNode .
  ?groupExtLinkNode rdf:type otl:ExternalLink .
  ?groupExtLinkNode otl:attr-ExternalLink-name ?groupName .
  ?groupExtLinkNode otl:attr-ExternalLink-relation "isSameAs" .
  ?groupExtLinkNode otl:attr-ExternalLink-sourcename "$external_sourcename" .
  ?groupExtLinkNode otl:attr-ExternalLink-sourceurl "$external_sourceurl"^^xsd:anyURI .
  ?groupExtLinkNode otl:attr-ExternalLink-uri ?groupExtURI .

  # # ── Block C: Qualification members (description = original 5.0 URI) ──────
  # ?enumGroup otl:rel-Group-isCollectionFor ?member .
  # ?member a otl:Qualification .
  # ?member otl:attr-Conceptual-name ?memberLabel .
  # ?member otl:attr-Conceptual-description ?memberOriginalUri .
  # ?member shapes:sequence ?memberSeqNode .
  # ?memberSeqNode rdf:type otl:Seq_attr-Conceptual-name .
  # ?memberSeqNode rdf:_1 ?memberLabel .
  # ?memberSeqNode owl:annotatedProperty otl:attr-Conceptual-name .

  # ── Block D: External link → shared GroupForQualifications ───────────────
  # Links the local aspect to the canonical group URI produced by
  # construct_shared_as_laces_otl.rq, so the workspace knows which shared
  # concept this mirrors.
  ?aspectProp otl:rel-Conceptual-hasExternalLink ?extLinkNode .
  ?extLinkNode rdf:type otl:ExternalLink .
  ?extLinkNode otl:attr-ExternalLink-name ?aspectLabel .
  ?extLinkNode otl:attr-ExternalLink-relation  "isSameAs" .
  ?extLinkNode otl:attr-ExternalLink-sourcename "$external_sourcename" .
  ?extLinkNode otl:attr-ExternalLink-sourceurl "$external_sourceurl"^^xsd:anyURI .
  ?extLinkNode otl:attr-ExternalLink-uri ?extURI .


}

WHERE {

  # ── Block A: owl:ObjectProperty (Status / Discipline) → otl:Aspect ───────
  {
    ?aspectProp a owl:ObjectProperty ; skos:prefLabel ?aspectLabel .
    FILTER (?aspectLabel IN ("Status", "Discipline"))
    BIND (IF(?aspectLabel = "Status", "Statussen", "Disciplines") AS ?groupName)
    ?enumGroup a owl:Class ;
               rdfs:subClassOf nen2660:EnumerationType ;
               skos:prefLabel ?groupName .
    BIND (IRI(CONCAT(STR(?aspectProp), "-seq-name")) AS ?aspectSeqNode)
    BIND (IRI(CONCAT(STR(?aspectProp), "-ext-link")) AS ?extLinkNode)
    BIND (STRDT(STR(?aspectProp), xsd:anyURI) AS ?extURI)
  }

  UNION

  # ── Block B: GroupForQualifications ─────────────────────────────────────
  {
    ?enumGroup a owl:Class ;
               rdfs:subClassOf nen2660:EnumerationType ;
               skos:prefLabel ?groupName .
    FILTER (?groupName IN ("Statussen", "Disciplines"))
    BIND (IRI(CONCAT(STR(?enumGroup), "-seq-name")) AS ?groupSeqNode)
    BIND (IRI(CONCAT(STR(?enumGroup), "-ext-link")) AS ?groupExtLinkNode)
    BIND (STRDT(STR(?enumGroup), xsd:anyURI) AS ?groupExtURI)
  }

  UNION

  # ── Block C: Qualification members — name + original URI as description ──
  {
    ?enumGroup a owl:Class ;
               rdfs:subClassOf nen2660:EnumerationType ;
               skos:prefLabel ?groupName .
    FILTER (?groupName IN ("Statussen", "Disciplines"))
    ?member a ?enumGroup .
    ?member skos:prefLabel ?memberLabel .
    BIND (STR(?member) AS ?memberOriginalUri)
    BIND (IRI(CONCAT(STR(?member), "-seq-name")) AS ?memberSeqNode)
  }

}
