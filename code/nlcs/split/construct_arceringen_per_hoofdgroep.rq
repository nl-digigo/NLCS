PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX nen2660: <https://w3id.org/nen2660/def#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX otl:     <http://www.laces.tech/publication/ns/semmtech/live/laces/schema/otl-manager/>
PREFIX shapes:  <http://www.laces.tech/publication/ns/semmtech/live/laces/schema/shapes/>

# ─────────────────────────────────────────────────────────────────────────────
# construct_arceringen_per_hoofdgroep.rq
#
# Constructs Laces OTL schema triples for Arcering classes referenced via
# nen2660:isDescribedBy from objects in one hoofdgroep.
# $hoofdgroup_name is replaced by the Python script before execution.
#
# Scope: for each top-level Arcering category (direct child of "Arcering", e.g.
# "AVH" for VerHardingen) that this hoofdgroep's objects reference at all, the
# WHOLE category subtree is included - not just the specific arceringen actually
# referenced. This carries over unused-but-legitimate siblings (e.g. an "Overig"
# catch-all with no current object references) alongside the ones in active use.
#
# Block A  — arcering class hierarchy           → otl:Document
# Block B  — annotation properties              → otl:InformationField
# Block C  — original NLCS URI                 → otl:InformationField
# Block D  — original NLCS URI for the Arcering root concept → otl:InformationField
# ─────────────────────────────────────────────────────────────────────────────

CONSTRUCT {

  # ── Block A ───────────────────────────────────────────────────────────────
  ?arcURI a otl:Document .
  ?arcURI shapes:sequence ?seqNode .
  ?seqNode rdf:type otl:Seq_attr-Conceptual-name .
  ?seqNode rdf:_1 ?label .
  ?seqNode owl:annotatedProperty otl:attr-Conceptual-name .
  ?arcURI otl:attr-Conceptual-name ?label .
  ?arcURI otl:rel-Conceptual-isSpecializationOf ?parent .
  ?arcURI otl:attr-Conceptual-description ?def .

  # ── Block B ───────────────────────────────────────────────────────────────
  ?arcURI2 otl:rel-Conceptual-isDescribedIn ?infoField .
  ?infoField a otl:InformationField .
  ?infoField otl:attr-InformationField-value ?annValueStr .
  ?infoField otl:rel-InformationField-isClassifiedAs ?annTypeNode .
  ?annTypeNode a otl:InformationType .
  ?annTypeNode otl:attr-Conceptual-name ?annLabel .

  # ── Block C ───────────────────────────────────────────────────────────────
  ?arcURI3 otl:rel-Conceptual-isDescribedIn ?uriField .
  ?uriField a otl:InformationField .
  ?uriField otl:attr-InformationField-value ?uriStr .
  ?uriField otl:rel-InformationField-isClassifiedAs <urn:nlcs:info-type:OriginalURI> .
  <urn:nlcs:info-type:OriginalURI> a otl:InformationType .
  <urn:nlcs:info-type:OriginalURI> otl:attr-Conceptual-name "Original URI" .

  # ── Block D: original NLCS URI for the Arcering root concept ──────────────
  ?arcURI4 otl:rel-Conceptual-isDescribedIn ?uriField2 .
  ?uriField2 a otl:InformationField .
  ?uriField2 otl:attr-InformationField-value ?uriStr2 .
  ?uriField2 otl:rel-InformationField-isClassifiedAs <urn:nlcs:info-type:OriginalURI> .

}

WHERE {

  VALUES (?hoofdgroep) { ("$hoofdgroup_name") }

  # ── Block A0: Arcering root Document ──────────────────────────────────────
  {
    ?arcURI a owl:Class ; skos:prefLabel "Arcering" .
    BIND ("Arcering" AS ?label)
    BIND (IRI(CONCAT(STR(?arcURI), "-seq-name")) AS ?seqNode)
  }

  UNION

  # ── Block A: arcering classes in scope → otl:Document triples ────────────
  {
    ?ArceringTopA a owl:Class ; skos:prefLabel "Arcering" .
    # Distinct top-level Arcering categories (direct children of Arcering) that
    # this hoofdgroep's objects reference at all - computed once via a DISTINCT
    # subquery (same technique Block B already uses for ?annProp) so the
    # per-category subtree expansion below runs once per category, not once
    # per object/reference - the whole-category scan is expensive on a large
    # tree and must not be repeated per referencing object.
    {
      SELECT DISTINCT ?topCatA WHERE {
        VALUES (?hgNameA) { ("$hoofdgroup_name") }
        ?NLCSObjectTopA0 a owl:Class ; skos:prefLabel "NLCS-object" .
        ?hgA0 rdfs:subClassOf ?NLCSObjectTopA0 ; skos:prefLabel ?hgNameA .
        ?objA0 rdfs:subClassOf+ ?hgA0 ; a owl:Class .
        ?objA0 rdfs:subClassOf ?bnodeArcA0 .
        ?bnodeArcA0 owl:onProperty nen2660:isDescribedBy .
        ?bnodeArcA0 owl:onClass ?linkedArcA0 .
        ?ArceringTopA0 a owl:Class ; skos:prefLabel "Arcering" .
        ?linkedArcA0 rdfs:subClassOf+ ?ArceringTopA0 .
        ?topCatA rdfs:subClassOf ?ArceringTopA0 .
        ?linkedArcA0 rdfs:subClassOf* ?topCatA .
      }
    }
    # Whole top-category subtree, not just the specific branch referenced - so
    # unused-but-legitimate siblings (e.g. an "Overig" catch-all) are carried
    # over too.
    { ?arcURI a owl:Class . FILTER (?arcURI = ?topCatA) }
    UNION
    { ?arcURI rdfs:subClassOf+ ?topCatA . }
    ?arcURI a owl:Class .
    ?arcURI skos:prefLabel ?label .
    OPTIONAL {
      ?arcURI rdfs:subClassOf ?parent .
      FILTER (!isBlank(?parent))
      ?parent a owl:Class .
    }
    OPTIONAL { ?arcURI skos:definition ?def }
    BIND (IRI(CONCAT(STR(?arcURI), "-seq-name")) AS ?seqNode)
  }

  UNION

  # ── Block B: annotation properties × arceringen cross-join ────────────────
  {
    {
      SELECT DISTINCT ?annProp ?annLabel WHERE {
        # Distinct top categories first (see Block A comment) so the ?anyArc
        # subtree scan below runs once per category, not once per object.
        {
          SELECT DISTINCT ?topCatB WHERE {
            VALUES (?hgNameB) { ("$hoofdgroup_name") }
            ?NLCSObjectTopB0 a owl:Class ; skos:prefLabel "NLCS-object" .
            ?hgB0 rdfs:subClassOf ?NLCSObjectTopB0 ; skos:prefLabel ?hgNameB .
            ?objB0 rdfs:subClassOf+ ?hgB0 ; a owl:Class .
            ?objB0 rdfs:subClassOf ?bnodeArcB0 .
            ?bnodeArcB0 owl:onProperty nen2660:isDescribedBy .
            ?bnodeArcB0 owl:onClass ?linkedArcB0 .
            ?ArceringTopB0 a owl:Class ; skos:prefLabel "Arcering" .
            ?linkedArcB0 rdfs:subClassOf+ ?ArceringTopB0 .
            ?topCatB rdfs:subClassOf ?ArceringTopB0 .
            ?linkedArcB0 rdfs:subClassOf* ?topCatB .
          }
        }
        ?anyArc rdfs:subClassOf* ?topCatB .
        ?anyArc ?annProp ?v .
        ?annProp a owl:AnnotationProperty ; skos:prefLabel ?annLabel .
      }
    }
    {
      SELECT DISTINCT ?topCatBO WHERE {
        VALUES (?hgNameBO) { ("$hoofdgroup_name") }
        ?NLCSObjectTopBO0 a owl:Class ; skos:prefLabel "NLCS-object" .
        ?hgBO0 rdfs:subClassOf ?NLCSObjectTopBO0 ; skos:prefLabel ?hgNameBO .
        ?objBO0 rdfs:subClassOf+ ?hgBO0 ; a owl:Class .
        ?objBO0 rdfs:subClassOf ?bnodeArcBO0 .
        ?bnodeArcBO0 owl:onProperty nen2660:isDescribedBy .
        ?bnodeArcBO0 owl:onClass ?linkedArcBO0 .
        ?ArceringTopBO0 a owl:Class ; skos:prefLabel "Arcering" .
        ?linkedArcBO0 rdfs:subClassOf+ ?ArceringTopBO0 .
        ?topCatBO rdfs:subClassOf ?ArceringTopBO0 .
        ?linkedArcBO0 rdfs:subClassOf* ?topCatBO .
      }
    }
    ?arcURI2 rdfs:subClassOf* ?topCatBO .
    ?arcURI2 a owl:Class .
    OPTIONAL { ?arcURI2 ?annProp ?litVal . FILTER (isLiteral(?litVal)) }
    OPTIONAL {
      ?arcURI2 ?annProp ?uriVal .
      FILTER (!isLiteral(?uriVal) && !isBlank(?uriVal))
      OPTIONAL { ?uriVal skos:prefLabel ?uriLabelOpt . }
      BIND (COALESCE(STR(?uriLabelOpt), STR(?uriVal)) AS ?uriLabel)
    }
    BIND (COALESCE(STR(?litVal), ?uriLabel, "") AS ?annValueStr)
    BIND (IRI(CONCAT(STR(?arcURI2), "-field-", SHA1(STR(?annProp)))) AS ?infoField)
    BIND (IRI(CONCAT(STR(?annProp), "-info-type")) AS ?annTypeNode)
  }

  UNION

  # ── Block C: original NLCS URI stored as InformationField ─────────────────
  {
    {
      SELECT DISTINCT ?topCatC WHERE {
        VALUES (?hgNameC) { ("$hoofdgroup_name") }
        ?NLCSObjectTopC0 a owl:Class ; skos:prefLabel "NLCS-object" .
        ?hgC0 rdfs:subClassOf ?NLCSObjectTopC0 ; skos:prefLabel ?hgNameC .
        ?objC0 rdfs:subClassOf+ ?hgC0 ; a owl:Class .
        ?objC0 rdfs:subClassOf ?bnodeArcC0 .
        ?bnodeArcC0 owl:onProperty nen2660:isDescribedBy .
        ?bnodeArcC0 owl:onClass ?linkedArcC0 .
        ?ArceringTopC0 a owl:Class ; skos:prefLabel "Arcering" .
        ?linkedArcC0 rdfs:subClassOf+ ?ArceringTopC0 .
        ?topCatC rdfs:subClassOf ?ArceringTopC0 .
        ?linkedArcC0 rdfs:subClassOf* ?topCatC .
      }
    }
    ?arcURI3 rdfs:subClassOf* ?topCatC .
    ?arcURI3 a owl:Class .
    BIND (STR(?arcURI3) AS ?uriStr)
    BIND (IRI(CONCAT(STR(?arcURI3), "-field-uri")) AS ?uriField)
  }

  UNION

  # ── Block D: original NLCS URI for the Arcering root concept ──────────────
  {
    ?arcURI4 a owl:Class ; skos:prefLabel "Arcering" .
    BIND (STR(?arcURI4) AS ?uriStr2)
    BIND (IRI(CONCAT(STR(?arcURI4), "-field-uri")) AS ?uriField2)
  }

}
