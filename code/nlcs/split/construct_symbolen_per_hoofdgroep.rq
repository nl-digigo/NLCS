PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX nen2660: <https://w3id.org/nen2660/def#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>
PREFIX otl:     <http://www.laces.tech/publication/ns/semmtech/live/laces/schema/otl-manager/>
PREFIX shapes:  <http://www.laces.tech/publication/ns/semmtech/live/laces/schema/shapes/>

# ─────────────────────────────────────────────────────────────────────────────
# construct_symbolen_per_hoofdgroep.rq
#
# Constructs Laces OTL schema triples for Symbool classes referenced via
# nen2660:isDescribedBy from objects in one hoofdgroep.
# $hoofdgroup_name is replaced by the Python script before execution.
#
# Scope: for each top-level Symbool category (direct child of "Symbool", e.g.
# "SVH" for VerHardingen) that this hoofdgroep's objects reference at all, the
# WHOLE category subtree is included - not just the specific symbolen actually
# referenced. This carries over unused-but-legitimate siblings (e.g. an "Overig"
# catch-all with no current object references) alongside the ones in active use.
#
# Block A  — symbool class hierarchy            → otl:Document
# Block B  — annotation properties              → otl:InformationField
# Block C  — original NLCS URI                 → otl:InformationField
# Block D  — original NLCS URI for the Symbool root concept → otl:InformationField
# ─────────────────────────────────────────────────────────────────────────────

CONSTRUCT {

  # ── Block A ───────────────────────────────────────────────────────────────
  ?symURI a otl:Document .
  ?symURI shapes:sequence ?seqNode .
  ?seqNode rdf:type otl:Seq_attr-Conceptual-name .
  ?seqNode rdf:_1 ?label .
  ?seqNode owl:annotatedProperty otl:attr-Conceptual-name .
  ?symURI otl:attr-Conceptual-name ?label .
  ?symURI otl:rel-Conceptual-isSpecializationOf ?parent .
  ?symURI otl:attr-Conceptual-description ?def .

  # ── Block B ───────────────────────────────────────────────────────────────
  ?symURI2 otl:rel-Conceptual-isDescribedIn ?infoField .
  ?infoField a otl:InformationField .
  ?infoField otl:attr-InformationField-value ?annValueStr .
  ?infoField otl:rel-InformationField-isClassifiedAs ?annTypeNode .
  ?annTypeNode a otl:InformationType .
  ?annTypeNode otl:attr-Conceptual-name ?annLabel .

  # ── Block C ───────────────────────────────────────────────────────────────
  ?symURI3 otl:rel-Conceptual-isDescribedIn ?uriField .
  ?uriField a otl:InformationField .
  ?uriField otl:attr-InformationField-value ?uriStr .
  ?uriField otl:rel-InformationField-isClassifiedAs <urn:nlcs:info-type:OriginalURI> .
  <urn:nlcs:info-type:OriginalURI> a otl:InformationType .
  <urn:nlcs:info-type:OriginalURI> otl:attr-Conceptual-name "Original URI" .

  # ── Block D: original NLCS URI for the Symbool root concept ───────────────
  ?symURI4 otl:rel-Conceptual-isDescribedIn ?uriField2 .
  ?uriField2 a otl:InformationField .
  ?uriField2 otl:attr-InformationField-value ?uriStr2 .
  ?uriField2 otl:rel-InformationField-isClassifiedAs <urn:nlcs:info-type:OriginalURI> .

}

WHERE {

  VALUES (?hoofdgroep) { ("$hoofdgroup_name") }

  # ── Block A0: Symbool root Document ───────────────────────────────────────
  {
    ?symURI a owl:Class ; skos:prefLabel "Symbool" .
    BIND ("Symbool" AS ?label)
    BIND (IRI(CONCAT(STR(?symURI), "-seq-name")) AS ?seqNode)
  }

  UNION

  # ── Block A: symbool classes in scope → otl:Document triples ─────────────
  {
    ?SymboolTopA a owl:Class ; skos:prefLabel "Symbool" .
    # Distinct top-level Symbool categories (direct children of Symbool) that
    # this hoofdgroep's objects reference at all - computed once via a DISTINCT
    # subquery (same technique Block B already uses for ?annProp) so the
    # per-category subtree expansion below runs once per category, not once
    # per object/reference - the whole-category scan is expensive on a large
    # tree and must not be repeated per referencing object.
    {
      SELECT DISTINCT ?topCatA WHERE {
        VALUES (?hgNameA) { ("$hoofdgroup_name") }
        ?NLCSObjectTopA0 a owl:Class ; skos:prefLabel "NLCS-object" .
        ?hgA0 rdfs:subClassOf ?NLCSObjectTopA0 ; skos:prefLabel ?hgNameA .
        ?objA0 rdfs:subClassOf+ ?hgA0 ; a owl:Class .
        ?objA0 rdfs:subClassOf ?bnodeSymA0 .
        ?bnodeSymA0 owl:onProperty nen2660:isDescribedBy .
        ?bnodeSymA0 owl:onClass ?linkedSymA0 .
        ?SymboolTopA0 a owl:Class ; skos:prefLabel "Symbool" .
        ?linkedSymA0 rdfs:subClassOf+ ?SymboolTopA0 .
        ?topCatA rdfs:subClassOf ?SymboolTopA0 .
        ?linkedSymA0 rdfs:subClassOf* ?topCatA .
      }
    }
    # Whole top-category subtree, not just the specific branch referenced - so
    # unused-but-legitimate siblings (e.g. an "Overig" catch-all) are carried
    # over too.
    { ?symURI a owl:Class . FILTER (?symURI = ?topCatA) }
    UNION
    { ?symURI rdfs:subClassOf+ ?topCatA . }
    ?symURI a owl:Class .
    ?symURI skos:prefLabel ?label .
    OPTIONAL {
      ?symURI rdfs:subClassOf ?parent .
      FILTER (!isBlank(?parent))
      ?parent a owl:Class .
    }
    OPTIONAL { ?symURI skos:definition ?def }
    BIND (IRI(CONCAT(STR(?symURI), "-seq-name")) AS ?seqNode)
  }

  UNION

  # ── Block B: annotation properties × symbolen cross-join ──────────────────
  {
    {
      SELECT DISTINCT ?annProp ?annLabel WHERE {
        # Distinct top categories first (see Block A comment) so the ?anySym
        # subtree scan below runs once per category, not once per object.
        {
          SELECT DISTINCT ?topCatB WHERE {
            VALUES (?hgNameB) { ("$hoofdgroup_name") }
            ?NLCSObjectTopB0 a owl:Class ; skos:prefLabel "NLCS-object" .
            ?hgB0 rdfs:subClassOf ?NLCSObjectTopB0 ; skos:prefLabel ?hgNameB .
            ?objB0 rdfs:subClassOf+ ?hgB0 ; a owl:Class .
            ?objB0 rdfs:subClassOf ?bnodeSymB0 .
            ?bnodeSymB0 owl:onProperty nen2660:isDescribedBy .
            ?bnodeSymB0 owl:onClass ?linkedSymB0 .
            ?SymboolTopB0 a owl:Class ; skos:prefLabel "Symbool" .
            ?linkedSymB0 rdfs:subClassOf+ ?SymboolTopB0 .
            ?topCatB rdfs:subClassOf ?SymboolTopB0 .
            ?linkedSymB0 rdfs:subClassOf* ?topCatB .
          }
        }
        ?anySym rdfs:subClassOf* ?topCatB .
        ?anySym ?annProp ?v .
        ?annProp a owl:AnnotationProperty ; skos:prefLabel ?annLabel .
      }
    }
    {
      SELECT DISTINCT ?topCatBO WHERE {
        VALUES (?hgNameBO) { ("$hoofdgroup_name") }
        ?NLCSObjectTopBO0 a owl:Class ; skos:prefLabel "NLCS-object" .
        ?hgBO0 rdfs:subClassOf ?NLCSObjectTopBO0 ; skos:prefLabel ?hgNameBO .
        ?objBO0 rdfs:subClassOf+ ?hgBO0 ; a owl:Class .
        ?objBO0 rdfs:subClassOf ?bnodeSymBO0 .
        ?bnodeSymBO0 owl:onProperty nen2660:isDescribedBy .
        ?bnodeSymBO0 owl:onClass ?linkedSymBO0 .
        ?SymboolTopBO0 a owl:Class ; skos:prefLabel "Symbool" .
        ?linkedSymBO0 rdfs:subClassOf+ ?SymboolTopBO0 .
        ?topCatBO rdfs:subClassOf ?SymboolTopBO0 .
        ?linkedSymBO0 rdfs:subClassOf* ?topCatBO .
      }
    }
    ?symURI2 rdfs:subClassOf* ?topCatBO .
    ?symURI2 a owl:Class .
    OPTIONAL { ?symURI2 ?annProp ?litVal . FILTER (isLiteral(?litVal)) }
    OPTIONAL {
      ?symURI2 ?annProp ?uriVal .
      FILTER (!isLiteral(?uriVal) && !isBlank(?uriVal))
      OPTIONAL { ?uriVal skos:prefLabel ?uriLabelOpt . }
      BIND (COALESCE(STR(?uriLabelOpt), STR(?uriVal)) AS ?uriLabel)
    }
    BIND (COALESCE(STR(?litVal), ?uriLabel, "") AS ?annValueStr)
    BIND (IRI(CONCAT(STR(?symURI2), "-field-", SHA1(STR(?annProp)))) AS ?infoField)
    BIND (IRI(CONCAT(STR(?annProp), "-info-type")) AS ?annTypeNode)
  }

  UNION

  # ── Block C: original NLCS URI stored as InformationField ─────────────────
  {
    {
      SELECT DISTINCT ?topCatC WHERE {
        VALUES (?hgNameC) { ("$hoofdgroup_name") }
        ?NLCSObjectTopC0 a owl:Class ; skos:prefLabel "NLCS-object" .
        ?hgC0 rdfs:subClassOf ?NLCSObjectTopC0 ; skos:prefLabel ?hgNameC .
        ?objC0 rdfs:subClassOf+ ?hgC0 ; a owl:Class .
        ?objC0 rdfs:subClassOf ?bnodeSymC0 .
        ?bnodeSymC0 owl:onProperty nen2660:isDescribedBy .
        ?bnodeSymC0 owl:onClass ?linkedSymC0 .
        ?SymboolTopC0 a owl:Class ; skos:prefLabel "Symbool" .
        ?linkedSymC0 rdfs:subClassOf+ ?SymboolTopC0 .
        ?topCatC rdfs:subClassOf ?SymboolTopC0 .
        ?linkedSymC0 rdfs:subClassOf* ?topCatC .
      }
    }
    ?symURI3 rdfs:subClassOf* ?topCatC .
    ?symURI3 a owl:Class .
    BIND (STR(?symURI3) AS ?uriStr)
    BIND (IRI(CONCAT(STR(?symURI3), "-field-uri")) AS ?uriField)
  }

  UNION

  # ── Block D: original NLCS URI for the Symbool root concept ───────────────
  {
    ?symURI4 a owl:Class ; skos:prefLabel "Symbool" .
    BIND (STR(?symURI4) AS ?uriStr2)
    BIND (IRI(CONCAT(STR(?symURI4), "-field-uri")) AS ?uriField2)
  }

}
